(version 1)
(rule "Default geometric minimums" (constraint clearance (min 0.25mm)) (constraint track_width (min 0.25mm)) (constraint edge_clearance (min 0.5mm)))
(rule "HV copper separation away from divider bodies" (condition "A.NetClass == 'HV' || B.NetClass == 'HV'") (constraint clearance (min 3.0mm)))
(rule "Explicit R1 1206 intended-net terminal-gap allowance" (condition "A.intersectsCourtyard('R1') && B.intersectsCourtyard('R1') && ((A.NetName == 'POS_SENSE' && B.NetName == 'VP1') || (A.NetName == 'VP1' && B.NetName == 'POS_SENSE'))") (constraint clearance (min 1.5mm)))
(rule "Explicit R2 1206 intended-net terminal-gap allowance" (condition "A.intersectsCourtyard('R2') && B.intersectsCourtyard('R2') && ((A.NetName == 'VP1' && B.NetName == 'VP2') || (A.NetName == 'VP2' && B.NetName == 'VP1'))") (constraint clearance (min 1.5mm)))
(rule "Explicit R3 1206 intended-net terminal-gap allowance" (condition "A.intersectsCourtyard('R3') && B.intersectsCourtyard('R3') && ((A.NetName == 'VP2' && B.NetName == 'VS_PLUS') || (A.NetName == 'VS_PLUS' && B.NetName == 'VP2'))") (constraint clearance (min 1.5mm)))
(rule "Explicit R5 1206 intended-net terminal-gap allowance" (condition "A.intersectsCourtyard('R5') && B.intersectsCourtyard('R5') && ((A.NetName == 'NEG_SENSE' && B.NetName == 'VN1') || (A.NetName == 'VN1' && B.NetName == 'NEG_SENSE'))") (constraint clearance (min 1.5mm)))
(rule "Explicit R6 1206 intended-net terminal-gap allowance" (condition "A.intersectsCourtyard('R6') && B.intersectsCourtyard('R6') && ((A.NetName == 'VN1' && B.NetName == 'VN2') || (A.NetName == 'VN2' && B.NetName == 'VN1'))") (constraint clearance (min 1.5mm)))
(rule "Explicit R7 1206 intended-net terminal-gap allowance" (condition "A.intersectsCourtyard('R7') && B.intersectsCourtyard('R7') && ((A.NetName == 'VN2' && B.NetName == 'VS_MINUS') || (A.NetName == 'VS_MINUS' && B.NetName == 'VN2'))") (constraint clearance (min 1.5mm)))
