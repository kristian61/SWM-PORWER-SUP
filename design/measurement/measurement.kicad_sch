(global_label "IMON_MINUS" (shape input) (at 152.4 256.54 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid 13d89b40-0cf8-49a5-bed7-ad592e87b334))
(text "PASSIVT MÅLEKORT UDKAST - IKKE 4 kW EFFEKTTRIN\nIngen forbindelse til 230 V AC eller PE. Flydende DC-sekundaer AGND." (at 15.24 20.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 8af9c97a-22ad-44cd-939e-8c5b8dbc0261))
(text "Vout = 40*(VMON_PLUS - VMON_MINUS), ideal unloaded ratio.\nBoth sense inputs: 0..120 V relative AGND; no negative common mode.\n130 k resistors rated >=100 V; max 39 V drop at 120 V total input." (at 15.24 125.73 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a89534ae-7062-402d-9441-c5c2ae2375ac))
(text "External 1 mohm four-terminal shunt >=10 W, rated >=50 A DC; outside PCB.\n40 A -> 40 mV; I = (IMON_PLUS - IMON_MINUS) / 0.001 ohm.\nTP1/TP2 energized HV: no hand probing; guarded fixture only." (at 15.24 203.2 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid de8ea45a-2fe2-4937-bf73-8728d3283629))
(text "No active protection, no ADC, no CC/CV control.\nMonitor loads affect gain; input impedance >=10 Mohm.\nDo not connect unpowered ADC. Prototype only." (at 228.6 228.6 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid dd6c5905-b8fd-4396-8ed4-0bb0f13ce0e0))
