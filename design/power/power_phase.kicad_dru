(version 1)
(rule "Default geometric minima" (constraint clearance (min 0.25mm)) (constraint track_width (min 0.18mm)) (constraint edge_clearance (min 1.0mm)))
(rule "HV and power functional spacing" (condition "A.NetClass == 'HV' || B.NetClass == 'HV' || A.NetClass == 'Power' || B.NetClass == 'Power'") (constraint clearance (min 1.5mm)))
(rule "U1 FE38 high-voltage package-local pad gap" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1')") (constraint clearance (min 0.7mm)))
(rule "U1 low-differential pair BG1-VINOV" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'BG1' && B.NetName == 'VINOV') || (A.NetName == 'VINOV' && B.NetName == 'BG1'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair VINOV-V5" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'VINOV' && B.NetName == 'V5') || (A.NetName == 'V5' && B.NetName == 'VINOV'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair V5-PGND" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'PGND') || (A.NetName == 'PGND' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair PGND-AUX12" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'PGND' && B.NetName == 'AUX12') || (A.NetName == 'AUX12' && B.NetName == 'PGND'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair AUX12-NDRV_TIE" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'AUX12' && B.NetName == 'NDRV_TIE') || (A.NetName == 'NDRV_TIE' && B.NetName == 'AUX12'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair NDRV_TIE-DRVCC" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'NDRV_TIE' && B.NetName == 'DRVCC') || (A.NetName == 'DRVCC' && B.NetName == 'NDRV_TIE'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair DRVCC-V5" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'DRVCC' && B.NetName == 'V5') || (A.NetName == 'V5' && B.NetName == 'DRVCC'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair V5-SS" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'SS') || (A.NetName == 'SS' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair SS-VFB" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SS' && B.NetName == 'VFB') || (A.NetName == 'VFB' && B.NetName == 'SS'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair VFB-SENSEP" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'VFB' && B.NetName == 'SENSEP') || (A.NetName == 'SENSEP' && B.NetName == 'VFB'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair SENSEP-SENSEN" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SENSEP' && B.NetName == 'SENSEN') || (A.NetName == 'SENSEN' && B.NetName == 'SENSEP'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair SENSEN-ITH" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SENSEN' && B.NetName == 'ITH') || (A.NetName == 'ITH' && B.NetName == 'SENSEN'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair ITH-PGND" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'ITH' && B.NetName == 'PGND') || (A.NetName == 'PGND' && B.NetName == 'ITH'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair V5-SYNC" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'SYNC') || (A.NetName == 'SYNC' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair SYNC-FREQ" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SYNC' && B.NetName == 'FREQ') || (A.NetName == 'FREQ' && B.NetName == 'SYNC'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair FREQ-PGOOD" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'FREQ' && B.NetName == 'PGOOD') || (A.NetName == 'PGOOD' && B.NetName == 'FREQ'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair PGOOD-BG2" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'PGOOD' && B.NetName == 'BG2') || (A.NetName == 'BG2' && B.NetName == 'PGOOD'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair SWB-TG2" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SWB' && B.NetName == 'TG2') || (A.NetName == 'TG2' && B.NetName == 'SWB'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair TG2-BST2" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'TG2' && B.NetName == 'BST2') || (A.NetName == 'BST2' && B.NetName == 'TG2'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair SWA-TG1" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SWA' && B.NetName == 'TG1') || (A.NetName == 'TG1' && B.NetName == 'SWA'))") (constraint clearance (min 0.2mm)))
(rule "U1 low-differential pair TG1-BST1" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'TG1' && B.NetName == 'BST1') || (A.NetName == 'BST1' && B.NetName == 'TG1'))") (constraint clearance (min 0.2mm)))
(rule "Q1 verified TDSON local geometry" (condition "A.intersectsCourtyard('Q1') && B.intersectsCourtyard('Q1')") (constraint clearance (min 0.5mm)))
(rule "Q2 verified TDSON local geometry" (condition "A.intersectsCourtyard('Q2') && B.intersectsCourtyard('Q2')") (constraint clearance (min 0.5mm)))
(rule "Q3 verified TDSON local geometry" (condition "A.intersectsCourtyard('Q3') && B.intersectsCourtyard('Q3')") (constraint clearance (min 0.5mm)))
(rule "Q4 verified TDSON local geometry" (condition "A.intersectsCourtyard('Q4') && B.intersectsCourtyard('Q4')") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair SWA-GA" (condition "((A.NetName == 'SWA' && B.NetName == 'GA') || (A.NetName == 'GA' && B.NetName == 'SWA'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair SWA-TG1" (condition "((A.NetName == 'SWA' && B.NetName == 'TG1') || (A.NetName == 'TG1' && B.NetName == 'SWA'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair SWA-BST1" (condition "((A.NetName == 'SWA' && B.NetName == 'BST1') || (A.NetName == 'BST1' && B.NetName == 'SWA'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair GA-TG1" (condition "((A.NetName == 'GA' && B.NetName == 'TG1') || (A.NetName == 'TG1' && B.NetName == 'GA'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair TG1-BST1" (condition "((A.NetName == 'TG1' && B.NetName == 'BST1') || (A.NetName == 'BST1' && B.NetName == 'TG1'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair SWB-GD" (condition "((A.NetName == 'SWB' && B.NetName == 'GD') || (A.NetName == 'GD' && B.NetName == 'SWB'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair SWB-TG2" (condition "((A.NetName == 'SWB' && B.NetName == 'TG2') || (A.NetName == 'TG2' && B.NetName == 'SWB'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair SWB-BST2" (condition "((A.NetName == 'SWB' && B.NetName == 'BST2') || (A.NetName == 'BST2' && B.NetName == 'SWB'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair GD-TG2" (condition "((A.NetName == 'GD' && B.NetName == 'TG2') || (A.NetName == 'TG2' && B.NetName == 'GD'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair TG2-BST2" (condition "((A.NetName == 'TG2' && B.NetName == 'BST2') || (A.NetName == 'BST2' && B.NetName == 'TG2'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair PREOUT-VOUT" (condition "((A.NetName == 'PREOUT' && B.NetName == 'VOUT') || (A.NetName == 'VOUT' && B.NetName == 'PREOUT'))") (constraint clearance (min 0.5mm)))
(rule "Low differential floating pair IAVGP-IAVGN" (condition "((A.NetName == 'IAVGP' && B.NetName == 'IAVGN') || (A.NetName == 'IAVGN' && B.NetName == 'IAVGP'))") (constraint clearance (min 0.5mm)))
(rule "R20 1206 divider terminal geometry" (condition "A.intersectsCourtyard('R20') && B.intersectsCourtyard('R20')") (constraint clearance (min 1.5mm)))
(rule "R21 1206 divider terminal geometry" (condition "A.intersectsCourtyard('R21') && B.intersectsCourtyard('R21')") (constraint clearance (min 1.5mm)))
(rule "R23 1206 divider terminal geometry" (condition "A.intersectsCourtyard('R23') && B.intersectsCourtyard('R23')") (constraint clearance (min 1.5mm)))
(rule "R24 1206 divider terminal geometry" (condition "A.intersectsCourtyard('R24') && B.intersectsCourtyard('R24')") (constraint clearance (min 1.5mm)))
(rule "C13 low differential at high common mode" (condition "A.intersectsCourtyard('C13') && B.intersectsCourtyard('C13')") (constraint clearance (min 0.5mm)))
(rule "C14 low differential at high common mode" (condition "A.intersectsCourtyard('C14') && B.intersectsCourtyard('C14')") (constraint clearance (min 0.5mm)))
(rule "D1 low differential at high common mode" (condition "A.intersectsCourtyard('D1') && B.intersectsCourtyard('D1')") (constraint clearance (min 0.5mm)))
(rule "D2 low differential at high common mode" (condition "A.intersectsCourtyard('D2') && B.intersectsCourtyard('D2')") (constraint clearance (min 0.5mm)))
(rule "C16 low differential at high common mode" (condition "A.intersectsCourtyard('C16') && B.intersectsCourtyard('C16')") (constraint clearance (min 0.5mm)))
(rule "R17 low differential at high common mode" (condition "A.intersectsCourtyard('R17') && B.intersectsCourtyard('R17')") (constraint clearance (min 0.5mm)))
(rule "R18 low differential at high common mode" (condition "A.intersectsCourtyard('R18') && B.intersectsCourtyard('R18')") (constraint clearance (min 0.5mm)))
(rule "R19 low differential at high common mode" (condition "A.intersectsCourtyard('R19') && B.intersectsCourtyard('R19')") (constraint clearance (min 0.5mm)))
(rule "R11 low differential at high common mode" (condition "A.intersectsCourtyard('R11') && B.intersectsCourtyard('R11')") (constraint clearance (min 0.5mm)))
(rule "R14 low differential at high common mode" (condition "A.intersectsCourtyard('R14') && B.intersectsCourtyard('R14')") (constraint clearance (min 0.5mm)))
(rule "U1 pad-only low differential BG1-VINOV" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'BG1' && B.NetName == 'VINOV') || (A.NetName == 'VINOV' && B.NetName == 'BG1'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential VINOV-V5" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'VINOV' && B.NetName == 'V5') || (A.NetName == 'V5' && B.NetName == 'VINOV'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential V5-PGND" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'PGND') || (A.NetName == 'PGND' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential PGND-AUX12" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'PGND' && B.NetName == 'AUX12') || (A.NetName == 'AUX12' && B.NetName == 'PGND'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential AUX12-NDRV_TIE" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'AUX12' && B.NetName == 'NDRV_TIE') || (A.NetName == 'NDRV_TIE' && B.NetName == 'AUX12'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential NDRV_TIE-DRVCC" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'NDRV_TIE' && B.NetName == 'DRVCC') || (A.NetName == 'DRVCC' && B.NetName == 'NDRV_TIE'))") (constraint clearance (min 0.2mm)))
