(rule "U1 final local pair DRVCC-V5" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'DRVCC' && B.NetName == 'V5') || (A.NetName == 'V5' && B.NetName == 'DRVCC'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair V5-SS" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'SS') || (A.NetName == 'SS' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair SS-VFB" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SS' && B.NetName == 'VFB') || (A.NetName == 'VFB' && B.NetName == 'SS'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair VFB-SENSEP" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'VFB' && B.NetName == 'SENSEP') || (A.NetName == 'SENSEP' && B.NetName == 'VFB'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair SENSEP-SENSEN" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SENSEP' && B.NetName == 'SENSEN') || (A.NetName == 'SENSEN' && B.NetName == 'SENSEP'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair SENSEN-ITH" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SENSEN' && B.NetName == 'ITH') || (A.NetName == 'ITH' && B.NetName == 'SENSEN'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair ITH-PGND" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'ITH' && B.NetName == 'PGND') || (A.NetName == 'PGND' && B.NetName == 'ITH'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair V5-SYNC" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'SYNC') || (A.NetName == 'SYNC' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair SYNC-FREQ" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SYNC' && B.NetName == 'FREQ') || (A.NetName == 'FREQ' && B.NetName == 'SYNC'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair FREQ-PGOOD" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'FREQ' && B.NetName == 'PGOOD') || (A.NetName == 'PGOOD' && B.NetName == 'FREQ'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair PGOOD-BG2" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'PGOOD' && B.NetName == 'BG2') || (A.NetName == 'BG2' && B.NetName == 'PGOOD'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair SWB-TG2" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SWB' && B.NetName == 'TG2') || (A.NetName == 'TG2' && B.NetName == 'SWB'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair TG2-BST2" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'TG2' && B.NetName == 'BST2') || (A.NetName == 'BST2' && B.NetName == 'TG2'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair SWA-TG1" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SWA' && B.NetName == 'TG1') || (A.NetName == 'TG1' && B.NetName == 'SWA'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair TG1-BST1" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'TG1' && B.NetName == 'BST1') || (A.NetName == 'BST1' && B.NetName == 'TG1'))") (constraint clearance (min 0.2mm)))
