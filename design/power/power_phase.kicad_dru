(rule "U1 pad-only low differential VFB-SENSEP" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'VFB' && B.NetName == 'SENSEP') || (A.NetName == 'SENSEP' && B.NetName == 'VFB'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential SENSEP-SENSEN" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SENSEP' && B.NetName == 'SENSEN') || (A.NetName == 'SENSEN' && B.NetName == 'SENSEP'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential SENSEN-ITH" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SENSEN' && B.NetName == 'ITH') || (A.NetName == 'ITH' && B.NetName == 'SENSEN'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential ITH-PGND" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'ITH' && B.NetName == 'PGND') || (A.NetName == 'PGND' && B.NetName == 'ITH'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential V5-SYNC" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'SYNC') || (A.NetName == 'SYNC' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential SYNC-FREQ" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SYNC' && B.NetName == 'FREQ') || (A.NetName == 'FREQ' && B.NetName == 'SYNC'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential FREQ-PGOOD" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'FREQ' && B.NetName == 'PGOOD') || (A.NetName == 'PGOOD' && B.NetName == 'FREQ'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential PGOOD-BG2" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'PGOOD' && B.NetName == 'BG2') || (A.NetName == 'BG2' && B.NetName == 'PGOOD'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential SWB-TG2" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SWB' && B.NetName == 'TG2') || (A.NetName == 'TG2' && B.NetName == 'SWB'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential TG2-BST2" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'TG2' && B.NetName == 'BST2') || (A.NetName == 'BST2' && B.NetName == 'TG2'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential SWA-TG1" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'SWA' && B.NetName == 'TG1') || (A.NetName == 'TG1' && B.NetName == 'SWA'))") (constraint clearance (min 0.2mm)))
(rule "U1 pad-only low differential TG1-BST1" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'TG1' && B.NetName == 'BST1') || (A.NetName == 'BST1' && B.NetName == 'TG1'))") (constraint clearance (min 0.2mm)))
(rule "U1 <=12 V local low-voltage fanout" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && (A.NetName == 'BG1' || A.NetName == 'BG2' || A.NetName == 'VINOV' || A.NetName == 'V5' || A.NetName == 'PGND' || A.NetName == 'AUX12' || A.NetName == 'NDRV_TIE' || A.NetName == 'DRVCC' || A.NetName == 'SS' || A.NetName == 'VFB' || A.NetName == 'SENSEP' || A.NetName == 'SENSEN' || A.NetName == 'ITH' || A.NetName == 'SYNC' || A.NetName == 'FREQ' || A.NetName == 'PGOOD' || A.NetName == 'RUN') && (B.NetName == 'BG1' || B.NetName == 'BG2' || B.NetName == 'VINOV' || B.NetName == 'V5' || B.NetName == 'PGND' || B.NetName == 'AUX12' || B.NetName == 'NDRV_TIE' || B.NetName == 'DRVCC' || B.NetName == 'SS' || B.NetName == 'VFB' || B.NetName == 'SENSEP' || B.NetName == 'SENSEN' || B.NetName == 'ITH' || B.NetName == 'SYNC' || B.NetName == 'FREQ' || B.NetName == 'PGOOD' || B.NetName == 'RUN')") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair BG1-VINOV" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'BG1' && B.NetName == 'VINOV') || (A.NetName == 'VINOV' && B.NetName == 'BG1'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair VINOV-V5" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'VINOV' && B.NetName == 'V5') || (A.NetName == 'V5' && B.NetName == 'VINOV'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair V5-PGND" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'PGND') || (A.NetName == 'PGND' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair PGND-AUX12" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'PGND' && B.NetName == 'AUX12') || (A.NetName == 'AUX12' && B.NetName == 'PGND'))") (constraint clearance (min 0.2mm)))
(rule "U1 final local pair AUX12-NDRV_TIE" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'AUX12' && B.NetName == 'NDRV_TIE') || (A.NetName == 'NDRV_TIE' && B.NetName == 'AUX12'))") (constraint clearance (min 0.2mm)))
