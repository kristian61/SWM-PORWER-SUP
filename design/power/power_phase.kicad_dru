(rule "U1 pad-only low differential V5-SS" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'V5' && B.NetName == 'SS') || (A.NetName == 'SS' && B.NetName == 'V5'))") (constraint clearance (min 0.2mm)))
