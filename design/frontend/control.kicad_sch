27 1.27)) (justify left)) (uuid ce9be2a0-c187-4413-b8ba-187fc1d6c192)) (text "A2 upper module" (at 228.6 43.18 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 4985748e-5b84-4767-9984-e92ea5427d41)) (text "AUX12: 12 V / 100 mA control-only per module. No direct common MCU wiring.\nP_OK isolated contacts do not replace separate voltage, OVP, OTP and full bus supervision.\nCN2.5 (-S duplicate) and CN2.6 (CS parallel-current-share) intentionally unused." (at 15.24 261.62 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 6cc9c732-16de-48b9-a747-9881f623b994)) (sheet_instances (path "/" (page "1"))) (embedded_fonts no))
